<Project Sdk="Microsoft.NET.Sdk">

  <!--The file in BepInEx\plugins that locates Keel and opens explicitly selected startup preloader DLLs.-->
  <PropertyGroup>
    <AssemblyName>SeaPowerKeel.Stub</AssemblyName>
    <RootNamespace>SeaPowerKeel.Stub</RootNamespace>
    <Product>Keel stub: starts the Keel mod loader from the game's mod folders.</Product>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SeaPowerKeel\KeelNames.cs" Link="KeelNames.cs" />
    <Compile Include="..\SeaPowerKeel\ModFolders.cs" Link="ModFolders.cs" />
    <Compile Include="..\SeaPowerKeel\PreparationEntry.cs" Link="PreparationEntry.cs" />
    <Reference Include="Mono.Cecil"><HintPath>$(BepInExCore)\Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
    <InternalsVisibleTo Include="SeaPowerKeel.OfflineCheck" />
  </ItemGroup>

</Project>
